rules_version = '2';
// Watch Hub: each person can read and write only their own data (users/<their uid>/...).
service cloud.firestore {
  match /databases/{database}/documents {
    // The owner's own account (Google, verified email) may also read and manage everyone's data
    // for the in-app admin page.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'alyoushw@gmail.com'
        && request.auth.token.email_verified == true;
    }
    // Problem reports: any signed-in person may send one (as themselves); only the owner reads them.
    match /reports/{id} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }
    match /users/{uid} {
      allow read, write: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }
  }
}
